# # Autobot secrets
DISCORD_BOT_TOKEN=
BOT_ID=
BOT_SECRET=


# # GFC secrets
GFC_INTRO_SURVEY_LINK=


# # Sirrele
ADMIN_1_DISCORD_ID=
# # Pratik
ADMIN_2_DISCORD_ID=


# # Discord; Digital Junkyard
DISCORD_SERVER_ID=
ADMIN_ROLE_ID=
GENERAL_CHAT_CHANNEL_ID=
CHECKINS_VOICE_CHANNEL_ID=
VIRTUAL_OFFICE_VOICE_CHANNEL_ID=
FIRST_RESPONDERS_ROLE_ID=
EMPIRIC_ROLE_ID=
EMPIRIC_DEVS_ROLE_ID=
EMPIRIC_DAILY_REMINDER_THREAD_ID=
# Role allowed to start /voice recording sessions (falls back to Administrator permission when unset)
VOICE_RECORDER_ROLE_ID=
# Retention policy for recorded /voice session audio under ./audio.
#   keep-days:N — keep session audio dirs for N days; a startup sweep deletes older ones.
#   delete      — delete a session's audio dir right after a clean /voice stop, but only
#                 when the local export succeeded AND ingest succeeded (or is unconfigured).
#                 Crash-salvage dirs are never swept in this mode.
# Default when unset: keep-days:7
VOICE_AUDIO_RETENTION=


# # Notion; GitFitCode's Notion
NOTION_KEY=
NOTION_SUPPORT_TICKETS_DATABASE_ID=
NOTION_SUPPORT_TICKETS_DATABASE_STATUS_ID=
NOTION_SUPPORT_TICKETS_DATABASE_LINK=
NOTION_BACKLOG_DATABASE_ID=
NOTION_BACKLOG_DATABASE_LINK=


# # Open AI
OPENAI_API_KEY=

# # Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=


# # Conduit intake (voice transcript ingest)
# Full URL of conduit's intake endpoint, served by the conduit web bridge
# (`conduit web serve`, default port 8765), e.g. http://rig.local:8765/intake/documents
# Leave unset to skip ingest — /voice transcripts are still exported locally to exports/voice/.
CONDUIT_INGEST_URL=
# Bearer token for the intake endpoint. Must match the conduit-side
# CONDUIT_INTAKE_TOKEN; the target brain is picked on the conduit side via
# CONDUIT_INTAKE_BRAIN.
CONDUIT_INGEST_TOKEN=
GFC_PROJECT_HUB_ORIGIN=https://hub.example.invalid
